PORT=3000

# Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/course_management

# MongoDB Atlas (paste your connection string from Atlas → Connect → Drivers)
# Use the database name at the end (e.g. test or course_management)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/test?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/course_management
JWT_SECRET=your_jwt_secret_key_change_in_production
CLIENT_URL=http://localhost:5173

RESET_EXPIRY_MINUTES=60
RESET_JWT_EXPIRES=1h

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="Course App <your@gmail.com>"
